  "lyrics": [
    {
      "text": "When I find myself in times of trouble",
      "start_time": 27.04,
      "end_time": 33.8
    },
    {
      "text": "Mother Mary comes to me",
      "start_time": 33.8,
      "end_time": 40.56
    },
    {
      "text": "Speaking words of wisdom",
      "start_time": 40.56,
      "end_time": 47.32
    },
    {
      "text": "Let it be",
      "start_time": 47.32,
      "end_time": 54.08
    },
    {
      "text": "Let it be, let it be",
      "start_time": 54.08,
      "end_time": 60.84
    },
    {
      "text": "Let it be, let it be",
      "start_time": 60.84,
      "end_time": 64.22
    },
    {
      "text": "Whisper words of wisdom, let it be",
      "start_time": 64.22,
      "end_time": 67.6
    },
    {
      "text": "And when the broken-hearted people",
      "start_time": 67.6,
      "end_time": 74.36
    },
    {
      "text": "Living in the world agree",
      "start_time": 74.36,
      "end_time": 81.12
    },
    {
      "text": "There will be an answer",
      "start_time": 81.12,
      "end_time": 87.88
    },
    {
      "text": "Let it be",
      "start_time": 87.88,
      "end_time": 94.64
    },
    {
      "text": "Let it be, let it be",
      "start_time": 94.64,
      "end_time": 101.4
    },
    {
      "text": "Let it be, let it be",
      "start_time": 101.4,
      "end_time": 104.78
    },
    {
      "text": "There will be an answer, let it be",
      "start_time": 104.78,
      "end_time": 108.16
    },
    {
      "text": "And when the night is cloudy",
      "start_time": 138.58,
      "end_time": 145.34
    },
    {
      "text": "There is still a light that shines on me",
      "start_time": 145.34,
